# =============================================================================
# vLLM CPU dev environment — build.env  (COMPILE / INSTALL parameters)
# -----------------------------------------------------------------------------
# Consumed by:  uv pip install --editable .   (i.e. setup.py build)
#
# Target: WSL2 Ubuntu 22.04 (glibc 2.35), x86_64 Zen4 CPU (AVX512), no GPU.
# Strategy: install the PRECOMPILED CPU wheel (its native *.so kernels) and
# overlay our editable Python source. This avoids compiling csrc/ locally,
# which fails on GCC < 15 due to __builtin_cpu_supports("avx10.2").
#
# Usage:
#   source ~/.venv/bin/activate
#   set -a; source dev/build.env; set +a       # export build vars
#   uv pip install --editable .                 # build/install step
#
# The dev/build.ps1 helper reads this same file and drives the install in WSL.
# =============================================================================


# ----------------------------------------------------------------------------
# SCRIPT SETTINGS (read by dev/build.ps1; ignored by uv/vllm themselves).
# These tell the PowerShell helper where the WSL repo, venv, and uv binary are.
# ----------------------------------------------------------------------------
VLLM_DEV_REPO_PATH=/root/vllm
VLLM_DEV_VENV_PATH=/root/.venv
VLLM_DEV_UV=/root/.local/bin/uv


# Build vLLM for the CPU backend (not CUDA/ROCm). Selects CPU platform + kernels
# and skips all GPU toolchain detection during the build.
VLLM_TARGET_DEVICE=cpu

# Use precompiled native artifacts instead of compiling csrc/ locally.
# When 1, the build downloads/extracts prebuilt *.so kernels (_C.so, etc.)
# from a wheel and overlays them onto the editable Python tree.
# This is what lets pure-Python edits (e.g. KV connectors) take effect on
# restart with NO local C++ compilation.
VLLM_USE_PRECOMPILED=1

# Explicit URL of the precompiled CPU wheel to source the *.so kernels from.
# We pin it to a released tag because per-commit CPU nightlies are not always
# published (the auto-resolved commit wheel 404s otherwise).
# "the wheel" here == the compiled CPU inference kernels + packaged deps.
# Wheel tag notes:
#   - v0.29.0            : matched release; keep your git checkout on this tag
#   - +cpu               : CPU variant (AVX512/AVX2), not CUDA
#   - cp38-abi3          : stable ABI, works on Python 3.12
#   - manylinux_2_34     : needs glibc >= 2.34 (Ubuntu 22.04 has 2.35 — OK)
#   - x86_64             : Intel/AMD 64-bit
VLLM_PRECOMPILED_WHEEL_LOCATION=https://github.com/vllm-project/vllm/releases/download/v0.29.0/vllm-0.29.0+cpu-cp38-abi3-manylinux_2_34_x86_64.whl

# Declares the wheel VARIANT the build should expect ("cpu"). Kept for clarity;
# WHEEL_LOCATION above takes precedence, but this documents intent and is used
# by the resolver when LOCATION is not set.
VLLM_PRECOMPILED_WHEEL_VARIANT=cpu

# --- Alternative: FULL local build from source (Path B) -----------------------
# Only if you actually edit csrc/ CPU kernels. Requires GCC >= 15 for the
# avx10.2 builtin; on GCC 13/14 either patch the probe or upgrade the compiler.
# Uncomment these and UNSET VLLM_USE_PRECOMPILED to compile locally:
#   MAX_JOBS=2                         # cap parallel compiles (avoid OOM on APU/laptop)
#   CMAKE_DISABLE_FIND_PACKAGE_CUDA=ON # stop CMake grabbing a stray CUDA install
#   CMAKE_BUILD_TYPE=RelWithDebInfo    # keep symbols for gdb on the kernels
