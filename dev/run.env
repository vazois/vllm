# =============================================================================
# vLLM CPU dev environment — run.env  (RUNTIME parameters)
# -----------------------------------------------------------------------------
# Consumed by:  vllm serve ...   /   offline LLM(...)
#
# Usage:
#   source ~/.venv/bin/activate
#   set -a; source dev/run.env; set +a         # export runtime vars
#   vllm serve facebook/opt-125m --dtype bfloat16 \
#     --kv-transfer-config '{"kv_connector":"ExampleConnector","kv_role":"kv_both",
#       "kv_connector_extra_config":{"shared_storage_path":"'"$VLLM_KV_STORAGE_PATH"'"}}'
#
# The dev/serve.ps1 helper reads this same file and drives `vllm serve` in WSL.
# =============================================================================


# ----------------------------------------------------------------------------
# SCRIPT SETTINGS (read by dev/serve.ps1; ignored by vllm itself).
# These tell the PowerShell helper where the WSL repo and venv are.
# ----------------------------------------------------------------------------
VLLM_DEV_REPO_PATH=/root/vllm
VLLM_DEV_VENV_PATH=/root/.venv


# KV cache size in GiB reserved by the CPU backend. Larger => more concurrent
# requests / longer context, but comes out of system RAM. 0 = default/minimal.
VLLM_CPU_KVCACHE_SPACE=4

# OpenMP thread pinning for CPU inference. "auto" binds threads per NUMA node.
# Use an explicit range (e.g. 0-14) to reserve cores for the server front-end,
# or "nobind" to defer to OMP_NUM_THREADS.
VLLM_CPU_OMP_THREADS_BIND=auto

# Logging verbosity. INFO shows our [KVDBG] connector traces (save/load
# paths, cache hit/miss, requested input blocks) without the full DEBUG noise.
VLLM_LOGGING_LEVEL=INFO


# ----------------------------------------------------------------------------
# KV-CONNECTOR debug scenario (ExampleConnector: save/load KV to local disk)
# ----------------------------------------------------------------------------
# Directory where ExampleConnector writes per-layer safetensors KV blocks.
# Passed into --kv-transfer-config on the CLI (see Usage header above).
VLLM_KV_STORAGE_PATH=/tmp/vllm_kv


# ----------------------------------------------------------------------------
# LD_PRELOAD (only needed when running the CPU backend installed via a wheel)
# ----------------------------------------------------------------------------
# TCMalloc + Intel OpenMP improve/repair CPU runtime behavior. Find the real
# paths on your box and export, e.g.:
#   sudo find / -iname 'libtcmalloc_minimal.so.4'
#   sudo find / -iname 'libiomp5.so'
# LD_PRELOAD=/path/to/libtcmalloc_minimal.so.4:/path/to/libiomp5.so
